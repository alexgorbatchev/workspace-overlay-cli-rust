set dotenv-load := false

default:
    @just --list

build:
    cargo build --package workspace-overlay --all-targets --locked

test:
    cargo test --package workspace-overlay --all-targets --locked
    cargo test --package workspace-overlay --doc --locked

fmt:
    cargo fmt --package workspace-overlay -- --check

lint:
    cargo clippy --package workspace-overlay --all-targets --locked -- -D warnings

coverage:
    cargo llvm-cov --package workspace-overlay --exclude-from-report workspace-overlay-cli --all-targets --locked --fail-under-lines 90

check: fmt lint test coverage

fmt-check:
    cargo fmt --package workspace-overlay -- --check
